{
  "name": "axestudio",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "pnpm --filter @als/desktop dev",
    "build": "pnpm --filter @als/desktop build",
    "tauri": "pnpm --filter @als/desktop tauri",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "bindings:generate": "cargo run -p als-desktop --bin export-bindings",
    "bindings:check": "node scripts/check-bindings.mjs",
    "bench:budget": "node scripts/bench-perf-budget.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
